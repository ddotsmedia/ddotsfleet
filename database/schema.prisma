generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  active
  suspended
  closed
}

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

enum RoleCode {
  company_admin
  fleet_manager
  dispatcher
  maintenance_officer
  finance_officer
  supervisor
  driver
  read_only_management
}

model Tenant {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String       @unique
  country               String       @default("AE") @db.Char(2)
  timezone              String       @default("Asia/Dubai")
  currency              String       @default("AED") @db.Char(3)
  status                TenantStatus @default(active)
  taxRegistrationNumber String?      @map("tax_registration_number")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             String?      @map("created_by") @db.Uuid

  memberships TenantMembership[]
  roles       Role[]
  invitations Invitation[]
  vehicles    Vehicle[]
  importJobs  ImportJob[]
  drivers     Driver[]
  auditEvents AuditEvent[]

  @@map("tenants")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  identitySubject String?   @unique @map("identity_subject")
  displayName     String    @map("display_name")
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordHash    String?   @map("password_hash")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships     TenantMembership[]
  sessions        Session[]
  invitationsSent Invitation[]
  auditEvents     AuditEvent[]

  @@map("users")
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(invited)
  joinedAt  DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?          @map("created_by") @db.Uuid

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  grants Grant[]

  @@unique([tenantId, userId])
  @@unique([id, tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleCode  RoleCode @map("role_code")
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  grants      Grant[]

  @@unique([tenantId, roleCode])
  @@unique([id, tenantId])
  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  resource  String
  action    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Grant {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  grantedBy    String?  @map("granted_by") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)

  membership TenantMembership @relation(fields: [membershipId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role       Role             @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([membershipId, roleId])
  @@index([roleId])
  @@index([tenantId])
  @@map("grants")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("sessions")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  email       String
  roleCode    RoleCode  @map("role_code")
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invitedBy User   @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
  @@index([invitedById])
  @@map("invitations")
}

enum Emirate {
  abu_dhabi
  ajman
  dubai
  fujairah
  ras_al_khaimah
  sharjah
  umm_al_quwain
}

enum FuelType {
  petrol
  diesel
  hybrid
  electric
  lpg
}

enum Ownership {
  owned
  leased
  rented
}

enum VehicleStatus {
  active
  maintenance
  retired
}

model Vehicle {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  fleetCode   String?       @map("fleet_code")
  plateNumber String        @map("plate_number")
  emirate     Emirate
  vin         String?
  category    String
  make        String
  model       String
  year        Int?
  colour      String?
  fuelType    FuelType      @map("fuel_type")
  ownership   Ownership
  status      VehicleStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?       @map("created_by") @db.Uuid
  updatedBy   String?       @map("updated_by") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments VehicleAssignment[]

  @@unique([tenantId, plateNumber])
  @@unique([tenantId, fleetCode])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("vehicles")
}

enum DriverStatus {
  active
  suspended
  left
}

enum AssignmentStatus {
  active
  ended
}

model Driver {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  employeeCode     String       @map("employee_code")
  fullName         String       @map("full_name")
  phone            String?
  status           DriverStatus @default(active)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  updatedBy        String?      @map("updated_by") @db.Uuid

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  licences    DriverLicence[]
  assignments VehicleAssignment[]

  @@unique([tenantId, employeeCode])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("drivers")
}

model DriverLicence {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  driverId        String   @map("driver_id") @db.Uuid
  issuingCountry  String   @map("issuing_country") @db.Char(2)
  licenceNumber   String   @map("licence_number")
  licenceClasses  String[] @map("licence_classes")
  expiresAt       DateTime @map("expires_at") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid

  driver Driver @relation(fields: [driverId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, issuingCountry, licenceNumber])
  @@index([driverId, expiresAt])
  @@map("driver_licences")
}

/// One row per exclusive vehicle hand-over. Partial unique indexes (migration only) allow at most one
/// active assignment per vehicle and per driver.
model VehicleAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  vehicleId      String           @map("vehicle_id") @db.Uuid
  driverId       String           @map("driver_id") @db.Uuid
  status         AssignmentStatus @default(active)
  startAt        DateTime         @map("start_at") @db.Timestamptz(6)
  endAt          DateTime?        @map("end_at") @db.Timestamptz(6)
  startOdometer  Int              @map("start_odometer")
  endOdometer    Int?             @map("end_odometer")
  licenceOverride String?         @map("licence_override")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String?          @map("created_by") @db.Uuid
  endedBy        String?          @map("ended_by") @db.Uuid

  vehicle Vehicle @relation(fields: [vehicleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  driver  Driver  @relation(fields: [driverId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([vehicleId, startAt])
  @@index([driverId, startAt])
  @@map("vehicle_assignments")
}

/// Append-only. A database trigger rejects UPDATE and DELETE.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  action      String
  changes     Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId])
  @@map("audit_events")
}

enum ImportStatus {
  previewed
  committed
}

model ImportJob {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  createdBy   String?      @map("created_by") @db.Uuid
  status      ImportStatus @default(previewed)
  checksum    String
  totalRows   Int          @map("total_rows")
  validRows   Int          @map("valid_rows")
  errorRows   Int          @map("error_rows")
  rowErrors   Json         @map("row_errors")
  payload     Json
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  committedAt DateTime?    @map("committed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("import_jobs")
}
