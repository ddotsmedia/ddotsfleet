{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022", "module": "esnext", "moduleResolution": "bundler", "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve", "noEmit": true, "incremental": true, "allowJs": false, "isolatedModules": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
